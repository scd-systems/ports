#!/bin/sh
#
# PROVIDE: authpf_api
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable authpf-api:
#
# authpf_api_enable="YES"
# authpf_api_config="/usr/local/etc/authpf-api.conf"
# authpf_api_user="_authpf-api"
# authpf_api_group="_authpf-api"

. /etc/rc.subr

name="authpf_api"
rcvar=authpf_api_enable

authpf_api_env="PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"

load_rc_config $name

: ${authpf_api_enable:="NO"}
: ${authpf_api_config:="/usr/local/etc/authpf-api.conf"}
: ${authpf_api_user:="_authpf-api"}
: ${authpf_api_group:="_authpf-api"}
: ${authpf_api_loglevel:="info"}

authpf_api_logfile=$(grep 'logfile[[:space:]]*:' ${authpf_api_config} | tr -d ' ' | cut -d':' -f2)
: ${authpf_api_logfile:="/var/log/authpf-api.log"}

pidfile="/var/run/${name}.pid"
procname="/usr/local/sbin/authpf-api"
command="/usr/sbin/daemon"
command_args="-cf -p ${pidfile} -S ${procname} -c ${authpf_api_config} -v ${authpf_api_loglevel}"
start_precmd="authpf_api_precmd"

authpf_api_precmd()
{
	install -o ${authpf_api_user} -g ${authpf_api_group} -m 0640 /dev/null ${pidfile}
	if [ ! -f ${authpf_api_logfile} ] ; then
		install -o ${authpf_api_user} -g ${authpf_api_group} -m 0640 /dev/null ${authpf_api_logfile}
	fi
}

run_rc_command "$1"